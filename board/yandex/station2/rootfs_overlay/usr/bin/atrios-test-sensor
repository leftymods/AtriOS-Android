#!/usr/bin/env python3
import sys
import os
import time
import argparse

IIO_DEV = "/sys/bus/iio/devices/iio:device0"
ATTR_LUX = os.path.join(IIO_DEV, "in_intensity_input")
ATTR_RAW = os.path.join(IIO_DEV, "in_intensity_raw")
ATTR_GAIN = os.path.join(IIO_DEV, "in_intensity_hardwaregain")
ATTR_TIME = os.path.join(IIO_DEV, "in_intensity_integration_time")

def read_float(path):
    try:
        with open(path, "r") as f:
            return float(f.read().strip())
    except Exception:
        return None

def read_int(path):
    try:
        with open(path, "r") as f:
            return int(float(f.read().strip()))
    except Exception:
        return None

def set_val(path, val):
    try:
        with open(path, "w") as f:
            f.write(str(val))
        return True
    except Exception as e:
        print(f"Error setting {path}: {e}")
        return False

def main():
    parser = argparse.ArgumentParser(description="AtriOS Ambient Light Sensor (LTR-308ALS) Diagnostic Utility")
    parser.add_argument("--monitor", action="store_true", help="Live monitor ambient light levels in terminal")
    parser.add_argument("--gain", type=int, choices=[1, 3, 6, 9, 18], help="Set sensor hardware gain")
    parser.add_argument("--once", action="store_true", help="Print single reading and exit")
    parser.add_argument("--auto-dim-demo", action="store_true", help="Demonstrate auto-dimming logic based on lux")
    args = parser.parse_args()

    if not os.path.exists(IIO_DEV):
        print(f"[Sensor Test] ERROR: LTR308 device not found at {IIO_DEV}!")
        print("Ensure ltr308als01 driver is loaded: modprobe ltr308als01")
        sys.exit(1)

    if args.gain:
        if set_val(ATTR_GAIN, args.gain):
            print(f"[Sensor Test] Hardware gain set to {args.gain}x.")
        sys.exit(0)

    lux = read_float(ATTR_LUX)
    raw = read_int(ATTR_RAW)
    gain = read_int(ATTR_GAIN)
    itime = read_float(ATTR_TIME)

    if args.once:
        print(f"Illuminance: {lux:.2f} Lux (Raw: {raw}, Gain: {gain}x, Integration: {itime}s)")
        sys.exit(0)

    if args.auto_dim_demo:
        print("==================================================")
        print("   AtriOS Auto-Dimming Demonstration (LTR-308)     ")
        print("   Cover the sensor or shine light on it...        ")
        print("==================================================")
        try:
            while True:
                cur_lux = read_float(ATTR_LUX) or 0.0
                # Calculate display brightness (10 to 255) based on room lux
                # <5 lux: dark room -> 20 brightness
                # 5-50 lux: indoor dim -> 60-120 brightness
                # >150 lux: bright day -> 255 brightness
                if cur_lux < 5:
                    target_brightness = 25
                    category = "Dark Room (Night)"
                elif cur_lux < 50:
                    target_brightness = int(25 + (cur_lux - 5) * 2.0)
                    category = "Indoor Ambient (Evening)"
                elif cur_lux < 200:
                    target_brightness = int(115 + (cur_lux - 50) * 0.9)
                    category = "Normal Daylight"
                else:
                    target_brightness = 255
                    category = "Bright Direct Sunlight"

                bar = "=" * int(target_brightness / 12) + "-" * (21 - int(target_brightness / 12))
                print(f"\r[Lux: {cur_lux:6.2f}] Target Brightness: {target_brightness:3d}/255 [{bar}] ({category})   ", end="", flush=True)
                time.sleep(0.3)
        except KeyboardInterrupt:
            print("\n[Sensor Test] Exited.")
        sys.exit(0)

    print("==================================================")
    print("      AtriOS LTR-308 ALS Live Light Monitor       ")
    print(f"      Sensor node: {IIO_DEV}")
    print("      Cover top of station to see lux drop.       ")
    print("      Press Ctrl+C to stop.                       ")
    print("==================================================")
    try:
        while True:
            cur_lux = read_float(ATTR_LUX) or 0.0
            cur_raw = read_int(ATTR_RAW) or 0
            # Visual bar (0 to 100+ lux)
            bar_len = min(40, int(cur_lux / 2.5))
            bar = "#" * bar_len + "-" * (40 - bar_len)
            print(f"\r[Illuminance]: {cur_lux:7.2f} Lux | Raw ADC: {cur_raw:5d} | [{bar}]", end="", flush=True)
            time.sleep(0.2)
    except KeyboardInterrupt:
        print("\n[Sensor Test] Monitor stopped.")

if __name__ == "__main__":
    main()
