#!/usr/bin/env python3
"""
AtriOS Physical Controls & Software Mic Mute Diagnostic Utility
Tests:
  - Top Button 1: Assistant / Alice (KEY_VOICECOMMAND / KEY_POWER)
  - Top Button 2: Microphone Mute (KEY_MICMUTE) -> Toggles Software Mute + Red LED Ring
  - Rotary Knob: Volume up / down (KEY_PAGEUP / KEY_PAGEDOWN)
  - Ambient Light Sensor (LTR-308ALS live lux check)
  - Remote control keys (Bluetooth / IR)
"""

import sys
import os
import struct
import select
import time
import subprocess

EVENT_FORMAT = "QQHHi"
EVENT_SIZE = struct.calcsize(EVENT_FORMAT)
FB_RING = "/dev/fb5"
NUM_LEDS = 24
SENSOR_LUX_PATH = "/sys/bus/iio/devices/iio:device0/in_intensity_input"

KEY_NAMES = {
    582: "KEY_VOICECOMMAND (Top Button #1: Alice / Assistant Call)",
    116: "KEY_POWER (Top Button #1 Alt: Assistant / Power)",
    248: "KEY_MICMUTE (Top Button #2: Physical Microphone Mute)",
    104: "KEY_PAGEUP (Rotary Knob Clockwise -> Volume Up)",
    109: "KEY_PAGEDOWN (Rotary Knob Counter-Clockwise -> Volume Down)",
    256: "BTN_MISC / BTN_0 (Hardware VAD Trigger)",
    115: "KEY_VOLUMEUP (Remote Vol+)",
    114: "KEY_VOLUMEDOWN (Remote Vol-)",
    103: "KEY_UP (Remote D-Pad Up)",
    108: "KEY_DOWN (Remote D-Pad Down)",
    105: "KEY_LEFT (Remote D-Pad Left)",
    106: "KEY_RIGHT (Remote D-Pad Right)",
    28:  "KEY_ENTER (Remote OK)",
    158: "KEY_BACK (Remote Back)",
    172: "KEY_HOMEPAGE (Remote Home)",
}

def read_ambient_lux():
    if os.path.exists(SENSOR_LUX_PATH):
        try:
            with open(SENSOR_LUX_PATH, "r") as f:
                val = float(f.read().strip())
                return val * 0.2  # LTR-308ALS 0.2 lux/count
        except Exception:
            pass
    return None

def set_ring_red(active=True):
    if not os.path.exists(FB_RING):
        return
    try:
        with open(FB_RING, "wb") as f:
            if active:
                # Solid red ring (24 LEDs * RGB [255, 0, 0])
                f.write(bytes([255, 0, 0]) * NUM_LEDS)
            else:
                f.write(b"\x00" * (NUM_LEDS * 3))
            f.flush()
    except Exception:
        pass

def toggle_software_mic_mute(mute_state):
    """
    Applies software microphone mute:
    1. PipeWire audio source mute
    2. ALSA capture switch mute
    3. LED ring illuminated solid RED
    """
    # PipeWire mute
    try:
        val = "1" if mute_state else "0"
        subprocess.run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SOURCE@", val],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass
    # ALSA mute
    try:
        cmd = "mute" if mute_state else "unmute"
        subprocess.run(["amixer", "-c", "0", "sset", "Capture", cmd],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass
    set_ring_red(mute_state)

def discover_input_devices():
    devices = {}
    for i in range(12):
        path = f"/dev/input/event{i}"
        if os.path.exists(path):
            name = f"event{i}"
            sys_name_path = f"/sys/class/input/event{i}/device/name"
            if os.path.exists(sys_name_path):
                try:
                    with open(sys_name_path, "r") as f:
                        name = f.read().strip()
                except Exception:
                    pass
            devices[path] = name
    return devices

def main():
    devices = discover_input_devices()
    if not devices:
        print("[Buttons Test] ERROR: No /dev/input/event* devices detected!")
        sys.exit(1)

    print("==========================================================")
    print("      AtriOS Buttons, Knob, Sensor & Mic Mute Monitor     ")
    print("==========================================================")
    lux = read_ambient_lux()
    if lux is not None:
        print(f"Ambient Light Sensor (LTR-308ALS): \033[1;36m{lux:.1f} Lux\033[0m")
    else:
        print("Ambient Light Sensor (LTR-308ALS): Not detected on sysfs")

    print("\nDiscovered input devices:")
    open_fds = {}
    for path, name in devices.items():
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
            open_fds[fd] = (path, name)
            print(f"  * {path:18s} -> {name}")
        except Exception as e:
            print(f"  * {path:18s} -> (Could not open: {e})")

    print("\nPhysical Button Map:")
    print("  * Top Button 1: Assistant / Alice (KEY_VOICECOMMAND [582])")
    print("  * Top Button 2: Microphone Mute   (KEY_MICMUTE      [248])")
    print("  * Rotary Knob : Volume Wheel      (KEY_PAGEUP / KEY_PAGEDOWN)")
    print("\nListening for live hardware events... Press Ctrl+C to exit.")
    print("----------------------------------------------------------")

    mic_muted = False
    assistant_press_time = 0

    try:
        while True:
            rlist, _, _ = select.select(list(open_fds.keys()), [], [], 0.1)
            for fd in rlist:
                dev_path, dev_name = open_fds[fd]
                try:
                    data = os.read(fd, EVENT_SIZE * 16)
                    for offset in range(0, len(data), EVENT_SIZE):
                        chunk = data[offset:offset + EVENT_SIZE]
                        if len(chunk) < EVENT_SIZE:
                            continue
                        sec, usec, ev_type, ev_code, ev_value = struct.unpack(EVENT_FORMAT, chunk)
                        if ev_type == 1: # EV_KEY
                            ts = time.strftime("%H:%M:%S")
                            key_str = KEY_NAMES.get(ev_code, f"CODE_{ev_code}")

                            # Top Button 2 (Mic Mute Button)
                            if ev_code == 248:
                                if ev_value == 1: # Down
                                    mic_muted = not mic_muted
                                    toggle_software_mic_mute(mic_muted)
                                    status = "\033[1;31m[MUTED - RED RING ACTIVATED]\033[0m" if mic_muted else "\033[1;32m[UNMUTED - NORMAL]\033[0m"
                                    print(f"[{ts}] \033[1;33m>>> TOP BUTTON #2 (MIC MUTE) PRESSED <<<\033[0m -> {status}")
                                elif ev_value == 0: # Up
                                    print(f"[{ts}] Top Button #2 (Mic Mute) released")

                            # Top Button 1 (Assistant / Alice Button)
                            elif ev_code in (582, 116):
                                if ev_value == 1:
                                    assistant_press_time = time.time()
                                    print(f"[{ts}] \033[1;32m>>> TOP BUTTON #1 (ASSISTANT / ALICE) PRESSED <<<\033[0m")
                                elif ev_value == 0:
                                    duration = time.time() - assistant_press_time
                                    print(f"[{ts}] Top Button #1 released (Hold duration: {duration:.2f}s)")

                            # Rotary Knob
                            elif ev_code in (104, 109):
                                direction = "\033[1;34mClockwise (+Vol)\033[0m" if ev_code == 104 else "\033[1;35mCounter-Clockwise (-Vol)\033[0m"
                                if ev_value == 1:
                                    print(f"[{ts}] Rotary Knob Turned: {direction}")

                            # Other / Remote Keys
                            else:
                                state = "PRESSED " if ev_value == 1 else ("RELEASED" if ev_value == 0 else "REPEAT  ")
                                color = "\033[1;32m" if ev_value == 1 else "\033[0;37m"
                                reset = "\033[0m"
                                print(f"[{ts}] {color}[{state}]{reset} {key_str:<50s} ({dev_name})")
                except Exception:
                    pass
    except KeyboardInterrupt:
        print("\n[Buttons Test] Exited.")
    finally:
        set_ring_red(False)
        for fd in open_fds.keys():
            os.close(fd)

if __name__ == "__main__":
    main()
