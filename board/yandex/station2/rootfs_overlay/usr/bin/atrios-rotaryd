#!/usr/bin/env python3
"""
AtriOS Hardware Interaction Daemon (atrios-rotaryd)
Handles:
  - Rotary Knob: Volume up/down with animated LED ring arc feedback
  - Top Button #2 (KEY_MICMUTE): Software Microphone Mute toggle + Red LED ring
  - Top Button #1 (KEY_VOICECOMMAND / KEY_POWER): Alice/Assistant call, Play/Pause
"""

import sys
import os
import struct
import time
import subprocess
import select

FB_RING = "/dev/fb5"
NUM_LEDS = 24

KEY_VOICECOMMAND = 582
KEY_POWER = 116
KEY_MICMUTE = 248
KEY_PAGEUP = 104    # Knob CW
KEY_PAGEDOWN = 109  # Knob CCW

mic_muted = False
current_volume = 60

def set_ring_frame(frame):
    try:
        with open(FB_RING, "wb") as f:
            f.write(frame)
            f.flush()
    except Exception:
        pass

def show_mute_ring():
    # Solid red ring indicates mics are software-muted
    set_ring_frame(bytes([255, 0, 0]) * NUM_LEDS)

def show_volume_ring(vol_pct):
    if mic_muted:
        show_mute_ring()
        return
    active = int(round(NUM_LEDS * (vol_pct / 100.0)))
    frame = bytearray(NUM_LEDS * 3)
    for i in range(NUM_LEDS):
        if i < active:
            ratio = i / max(1, NUM_LEDS - 1)
            frame[i * 3 + 0] = int(180 * ratio)
            frame[i * 3 + 1] = int(220 * (1.0 - ratio))
            frame[i * 3 + 2] = 255
    set_ring_frame(frame)

def clear_ring():
    if mic_muted:
        show_mute_ring()
    else:
        set_ring_frame(b"\x00" * (NUM_LEDS * 3))

def toggle_software_mic_mute():
    global mic_muted
    mic_muted = not mic_muted
    val = "1" if mic_muted else "0"
    try:
        subprocess.run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SOURCE@", val],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass
    try:
        cmd = "mute" if mic_muted else "unmute"
        subprocess.run(["amixer", "-c", "0", "sset", "Capture", cmd],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass
    if mic_muted:
        show_mute_ring()
    else:
        clear_ring()

def adjust_volume(step):
    global current_volume
    current_volume = max(0, min(100, current_volume + step))
    sign = "+" if step > 0 else "-"
    pct = f"{abs(step)}%{sign}"
    try:
        subprocess.run(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", pct],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass
    try:
        subprocess.run(["amixer", "-c", "0", "sset", "Master", pct],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass
    show_volume_ring(current_volume)

def find_devices():
    devs = []
    for i in range(12):
        p = f"/dev/input/event{i}"
        if os.path.exists(p):
            devs.append(p)
    return devs

def main():
    EVENT_FORMAT = "QQHHi"
    EVENT_SIZE = struct.calcsize(EVENT_FORMAT)
    open_fds = {}

    for p in find_devices():
        try:
            fd = os.open(p, os.O_RDONLY | os.O_NONBLOCK)
            open_fds[fd] = p
        except Exception:
            pass

    top_press_time = 0
    last_volume_time = 0

    while True:
        rlist, _, _ = select.select(list(open_fds.keys()), [], [], 0.5)
        now = time.time()

        # Fade out volume bar after 2 seconds if not in mic mute mode
        if not mic_muted and last_volume_time > 0 and (now - last_volume_time > 2.0):
            clear_ring()
            last_volume_time = 0

        for fd in rlist:
            try:
                data = os.read(fd, EVENT_SIZE * 8)
                for offset in range(0, len(data), EVENT_SIZE):
                    chunk = data[offset:offset + EVENT_SIZE]
                    if len(chunk) < EVENT_SIZE:
                        continue
                    sec, usec, ev_type, ev_code, ev_value = struct.unpack(EVENT_FORMAT, chunk)
                    if ev_type == 1: # EV_KEY
                        # Rotary knob CW
                        if ev_code == KEY_PAGEUP and ev_value == 1:
                            adjust_volume(5)
                            last_volume_time = time.time()
                        # Rotary knob CCW
                        elif ev_code == KEY_PAGEDOWN and ev_value == 1:
                            adjust_volume(-5)
                            last_volume_time = time.time()
                        # Top Button 2: Dedicated Physical Microphone Mute
                        elif ev_code == KEY_MICMUTE and ev_value == 1:
                            toggle_software_mic_mute()
                        # Top Button 1: Assistant / Play-Pause
                        elif ev_code in (KEY_VOICECOMMAND, KEY_POWER):
                            if ev_value == 1:
                                top_press_time = time.time()
                            elif ev_value == 0:
                                duration = time.time() - top_press_time
                                if duration >= 2.5:
                                    # Very long press: trigger setup/bluetooth mode
                                    pass
                                else:
                                    # Short click: Toggle Play/Pause or Voice prompt
                                    try:
                                        subprocess.run(["playerctl", "play-pause"],
                                                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                                    except Exception:
                                        pass
            except Exception:
                pass

if __name__ == "__main__":
    main()
