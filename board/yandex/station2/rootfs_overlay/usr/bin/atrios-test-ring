#!/usr/bin/env python3
import sys
import time
import math
import os
import argparse

FB_DEV = "/dev/fb5"
SYSFS_BASE = "/sys/class/leds"
NUM_LEDS = 24

def set_fb_color(r, g, b):
    try:
        with open(FB_DEV, "wb") as f:
            data = bytes([int(r), int(g), int(b)]) * NUM_LEDS
            f.write(data)
            f.flush()
        return True
    except Exception as e:
        return False

def set_fb_frame(frame_bytes):
    try:
        with open(FB_DEV, "wb") as f:
            f.write(frame_bytes)
            f.flush()
        return True
    except Exception:
        return False

def set_sysfs_led(idx, r, g, b):
    for color, val in [("red", r), ("green", g), ("blue", b)]:
        p = f"{SYSFS_BASE}/station2:{color}:ring{idx}/brightness"
        if os.path.exists(p):
            try:
                with open(p, "w") as f:
                    f.write(str(int(val)))
            except Exception:
                pass

def chase_animation(speed=0.04, cycles=3):
    print(f"[Ring Test] Running chase animation ({cycles} cycles)...")
    for _ in range(cycles):
        for i in range(NUM_LEDS):
            frame = bytearray(NUM_LEDS * 3)
            # Head (bright cyan)
            frame[i * 3 + 0] = 0
            frame[i * 3 + 1] = 255
            frame[i * 3 + 2] = 255
            # Tail 1
            prev1 = (i - 1) % NUM_LEDS
            frame[prev1 * 3 + 0] = 0
            frame[prev1 * 3 + 1] = 100
            frame[prev1 * 3 + 2] = 180
            # Tail 2
            prev2 = (i - 2) % NUM_LEDS
            frame[prev2 * 3 + 0] = 0
            frame[prev2 * 3 + 1] = 20
            frame[prev2 * 3 + 2] = 60
            set_fb_frame(bytes(frame))
            time.sleep(speed)
    set_fb_color(0, 0, 0)

def rainbow_animation(duration=5.0):
    print(f"[Ring Test] Running smooth rainbow animation ({duration}s)...")
    start = time.time()
    offset = 0.0
    while time.time() - start < duration:
        frame = bytearray(NUM_LEDS * 3)
        for i in range(NUM_LEDS):
            hue = (i / NUM_LEDS + offset) % 1.0
            r = int(max(0, min(255, (math.sin(hue * 2 * math.pi) * 0.5 + 0.5) * 255)))
            g = int(max(0, min(255, (math.sin((hue + 0.33) * 2 * math.pi) * 0.5 + 0.5) * 255)))
            b = int(max(0, min(255, (math.sin((hue + 0.66) * 2 * math.pi) * 0.5 + 0.5) * 255)))
            frame[i * 3 + 0] = r
            frame[i * 3 + 1] = g
            frame[i * 3 + 2] = b
        set_fb_frame(bytes(frame))
        offset = (offset + 0.03) % 1.0
        time.sleep(0.03)
    set_fb_color(0, 0, 0)

def breath_animation(r, g, b, duration=4.0):
    print(f"[Ring Test] Breathing pulse effect with color ({r}, {g}, {b})...")
    start = time.time()
    while time.time() - start < duration:
        t = time.time() - start
        scale = (math.sin(t * 3.1415) * 0.5 + 0.5) ** 2
        set_fb_color(int(r * scale), int(g * scale), int(b * scale))
        time.sleep(0.02)
    set_fb_color(0, 0, 0)

def volume_bar(vol_pct):
    active = int(round(NUM_LEDS * (vol_pct / 100.0)))
    frame = bytearray(NUM_LEDS * 3)
    for i in range(NUM_LEDS):
        if i < active:
            # Gradient from green to yellow to purple/red
            ratio = i / max(1, NUM_LEDS - 1)
            frame[i * 3 + 0] = int(255 * ratio)
            frame[i * 3 + 1] = int(200 * (1.0 - ratio * 0.5))
            frame[i * 3 + 2] = int(255 * (1.0 - ratio))
    set_fb_frame(bytes(frame))

def main():
    parser = argparse.ArgumentParser(description="AtriOS Top 24-LED Ring Diagnostic Utility")
    parser.add_argument("--color", nargs=3, type=int, metavar=("R", "G", "B"), help="Set solid color (0-255)")
    parser.add_argument("--chase", action="store_true", help="Run chasing LED animation")
    parser.add_argument("--rainbow", action="store_true", help="Run rainbow spectrum animation")
    parser.add_argument("--breath", nargs=3, type=int, metavar=("R", "G", "B"), help="Run breathing pulse")
    parser.add_argument("--volume", type=int, metavar="PERCENT", help="Simulate circular volume bar (0-100)")
    parser.add_argument("--off", action="store_true", help="Turn off all ring LEDs")
    parser.add_argument("--sysfs", action="store_true", help="Test IS31FL32xx via sysfs driver")
    args = parser.parse_args()

    if args.off:
        set_fb_color(0, 0, 0)
        print("[Ring Test] All LEDs turned OFF.")
    elif args.color:
        set_fb_color(*args.color)
        print(f"[Ring Test] Solid color set: RGB={args.color}")
    elif args.chase:
        chase_animation()
    elif args.rainbow:
        rainbow_animation()
    elif args.breath:
        breath_animation(*args.breath)
    elif args.volume is not None:
        volume_bar(args.volume)
        print(f"[Ring Test] Volume ring set to {args.volume}%.")
    elif args.sysfs:
        print("[Ring Test] Cycling sysfs LEDs 1..24...")
        for i in range(1, NUM_LEDS + 1):
            set_sysfs_led(i, 200, 0, 200)
            time.sleep(0.05)
            set_sysfs_led(i, 0, 0, 0)
    else:
        print("[Ring Test] Running comprehensive self-test suite:")
        rainbow_animation(3.0)
        chase_animation(speed=0.03, cycles=2)
        breath_animation(150, 0, 255, duration=3.0)
        set_fb_color(0, 0, 0)
        print("[Ring Test] Self-test complete.")

if __name__ == "__main__":
    main()
