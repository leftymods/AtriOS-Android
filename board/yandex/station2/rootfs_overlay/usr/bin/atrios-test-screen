#!/usr/bin/env python3
"""
AtriOS Front Gowin 25x16 Monochrome LED Matrix Diagnostic & Animation Utility
Hardware:
  - Controller: Gowin FPGA over SPI (/dev/fb4)
  - Display: 25 columns x 16 rows monochrome white LED matrix
  - Pixel Format: 8-bit individual brightness (0..255) per LED
  - Driver Interface: gowin_led_device driver exposes RGB888 (24-bpp) framebuffer
  - Frame buffer size: exactly 1200 bytes (25 * 16 * 3)
  - Mapping: Driver computes LED brightness = max(R, G, B) for each (x, y) pixel
"""

import sys
import os
import time
import argparse

FB_DEV = "/dev/fb4"
WIDTH = 25
HEIGHT = 16
BPP = 3
FRAME_SIZE = WIDTH * HEIGHT * BPP

# 5x7 ASCII bitmap font (width=5, height=7)
FONT = {
    ' ': [0b00000, 0b00000, 0b00000, 0b00000, 0b00000, 0b00000, 0b00000],
    '0': [0b01110, 0b10001, 0b10011, 0b10101, 0b11001, 0b10001, 0b01110],
    '1': [0b00100, 0b01100, 0b00100, 0b00100, 0b00100, 0b00100, 0b01110],
    '2': [0b01110, 0b10001, 0b00001, 0b00110, 0b01000, 0b10000, 0b11111],
    '3': [0b11110, 0b00001, 0b00001, 0b01110, 0b00001, 0b00001, 0b11110],
    '4': [0b00010, 0b00110, 0b01010, 0b10010, 0b11111, 0b00010, 0b00010],
    '5': [0b11111, 0b10000, 0b11110, 0b00001, 0b00001, 0b10001, 0b01110],
    '6': [0b01110, 0b10000, 0b11110, 0b10001, 0b10001, 0b10001, 0b01110],
    '7': [0b11111, 0b00001, 0b00010, 0b00100, 0b01000, 0b01000, 0b01000],
    '8': [0b01110, 0b10001, 0b10001, 0b01110, 0b10001, 0b10001, 0b01110],
    '9': [0b01110, 0b10001, 0b10001, 0b01111, 0b00001, 0b00001, 0b01110],
    ':': [0b00000, 0b00100, 0b00100, 0b00000, 0b00100, 0b00100, 0b00000],
    '-': [0b00000, 0b00000, 0b00000, 0b11111, 0b00000, 0b00000, 0b00000],
    '.': [0b00000, 0b00000, 0b00000, 0b00000, 0b00000, 0b01100, 0b01100],
    '!': [0b00100, 0b00100, 0b00100, 0b00100, 0b00100, 0b00000, 0b00100],
    '?': [0b01110, 0b10001, 0b00001, 0b00010, 0b00100, 0b00000, 0b00100],
    'A': [0b01110, 0b10001, 0b10001, 0b11111, 0b10001, 0b10001, 0b10001],
    'B': [0b11110, 0b10001, 0b10001, 0b11110, 0b10001, 0b10001, 0b11110],
    'C': [0b01110, 0b10001, 0b10000, 0b10000, 0b10000, 0b10001, 0b01110],
    'D': [0b11100, 0b10010, 0b10001, 0b10001, 0b10001, 0b10010, 0b11100],
    'E': [0b11111, 0b10000, 0b10000, 0b11110, 0b10000, 0b10000, 0b11111],
    'F': [0b11111, 0b10000, 0b10000, 0b11110, 0b10000, 0b10000, 0b10000],
    'G': [0b01110, 0b10001, 0b10000, 0b10111, 0b10001, 0b10001, 0b01110],
    'H': [0b10001, 0b10001, 0b10001, 0b11111, 0b10001, 0b10001, 0b10001],
    'I': [0b01110, 0b00100, 0b00100, 0b00100, 0b00100, 0b00100, 0b01110],
    'J': [0b00001, 0b00001, 0b00001, 0b00001, 0b10001, 0b10001, 0b01110],
    'K': [0b10001, 0b10010, 0b10100, 0b11000, 0b10100, 0b10010, 0b10001],
    'L': [0b10000, 0b10000, 0b10000, 0b10000, 0b10000, 0b10000, 0b11111],
    'M': [0b10001, 0b11011, 0b10101, 0b10101, 0b10001, 0b10001, 0b10001],
    'N': [0b10001, 0b11001, 0b10101, 0b10011, 0b10001, 0b10001, 0b10001],
    'O': [0b01110, 0b10001, 0b10001, 0b10001, 0b10001, 0b10001, 0b01110],
    'P': [0b11110, 0b10001, 0b10001, 0b11110, 0b10000, 0b10000, 0b10000],
    'Q': [0b01110, 0b10001, 0b10001, 0b10001, 0b10101, 0b10010, 0b01101],
    'R': [0b11110, 0b10001, 0b10001, 0b11110, 0b10100, 0b10010, 0b10001],
    'S': [0b01111, 0b10000, 0b10000, 0b01110, 0b00001, 0b00001, 0b11110],
    'T': [0b11111, 0b00100, 0b00100, 0b00100, 0b00100, 0b00100, 0b00100],
    'U': [0b10001, 0b10001, 0b10001, 0b10001, 0b10001, 0b10001, 0b01110],
    'V': [0b10001, 0b10001, 0b10001, 0b10001, 0b10001, 0b01010, 0b00100],
    'W': [0b10001, 0b10001, 0b10001, 0b10101, 0b10101, 0b11011, 0b10001],
    'X': [0b10001, 0b10001, 0b01010, 0b00100, 0b01010, 0b10001, 0b10001],
    'Y': [0b10001, 0b10001, 0b01010, 0b00100, 0b00100, 0b00100, 0b00100],
    'Z': [0b11111, 0b00001, 0b00010, 0b00100, 0b01000, 0b10000, 0b11111],
}

def set_pixel(buf, x, y, brightness):
    """Set individual monochrome LED brightness (0..255) at (x, y)."""
    if 0 <= x < WIDTH and 0 <= y < HEIGHT:
        val = max(0, min(255, int(brightness)))
        offset = (y * WIDTH + x) * BPP
        buf[offset + 0] = val
        buf[offset + 1] = val
        buf[offset + 2] = val

def get_pixel(buf, x, y):
    if 0 <= x < WIDTH and 0 <= y < HEIGHT:
        offset = (y * WIDTH + x) * BPP
        return buf[offset]
    return 0

def send_frame(buf):
    """Write exact 1200-byte frame to Gowin framebuffer."""
    if len(buf) != FRAME_SIZE:
        print(f"[!] Warning: frame length is {len(buf)}, expected {FRAME_SIZE}", flush=True)
    try:
        with open(FB_DEV, "wb") as f:
            f.write(buf[:FRAME_SIZE])
            f.flush()
        return True
    except Exception as e:
        print(f"Error writing to {FB_DEV}: {e}", flush=True)
        return False

def clear_screen():
    send_frame(bytearray(FRAME_SIZE))
    print("[Screen] Cleared (all LEDs OFF).", flush=True)

def fill_screen(brightness=200):
    val = max(0, min(255, int(brightness)))
    buf = bytearray(FRAME_SIZE)
    for y in range(HEIGHT):
        for x in range(WIDTH):
            set_pixel(buf, x, y, val)
    send_frame(buf)
    print(f"[Screen] Filled with brightness {val}/255.", flush=True)

def draw_clock(brightness=220):
    now = time.strftime("%H:%M")
    buf = bytearray(FRAME_SIZE)
    x_positions = [1, 7, 12, 14, 20]
    for char, x_start in zip(now, x_positions):
        glyph = FONT.get(char, [0]*7)
        for row_idx, row_bits in enumerate(glyph):
            y = 4 + row_idx
            for col_idx in range(5):
                if (row_bits >> (4 - col_idx)) & 1:
                    set_pixel(buf, x_start + col_idx, y, brightness)
    send_frame(buf)
    print(f"[Screen] Clock displayed: {now} (brightness={brightness}/255)", flush=True)

def draw_eyes(state="open", brightness=220):
    """Cute animated Alice/robot eyes on 25x16 matrix."""
    buf = bytearray(FRAME_SIZE)
    dim = int(brightness * 0.4)

    if state == "open":
        for y in range(4, 11):
            for x in range(4, 9):
                set_pixel(buf, x, y, brightness)
            for x in range(16, 21):
                set_pixel(buf, x, y, brightness)
        set_pixel(buf, 5, 5, 255)
        set_pixel(buf, 17, 5, 255)

    elif state == "blink":
        for x in range(3, 10):
            set_pixel(buf, x, 7, brightness)
        for x in range(15, 22):
            set_pixel(buf, x, 7, brightness)

    elif state == "left":
        for y in range(4, 11):
            for x in range(2, 7):
                set_pixel(buf, x, y, brightness)
            for x in range(14, 19):
                set_pixel(buf, x, y, brightness)

    elif state == "right":
        for y in range(4, 11):
            for x in range(6, 11):
                set_pixel(buf, x, y, brightness)
            for x in range(18, 23):
                set_pixel(buf, x, y, brightness)

    elif state == "wink":
        for y in range(4, 11):
            for x in range(4, 9):
                set_pixel(buf, x, y, brightness)
        for x in range(15, 22):
            set_pixel(buf, x, 7, brightness)

    elif state == "happy":
        for x in range(4, 9):
            set_pixel(buf, x, 4, brightness)
        set_pixel(buf, 3, 5, brightness)
        set_pixel(buf, 9, 5, brightness)
        for x in range(16, 21):
            set_pixel(buf, x, 4, brightness)
        set_pixel(buf, 15, 5, brightness)
        set_pixel(buf, 21, 5, brightness)

    send_frame(buf)
    print(f"[Screen] Eyes displayed: {state} (brightness={brightness}/255)", flush=True)

def test_gradient():
    """Demonstrates individual 8-bit LED brightness control (0..255)."""
    buf = bytearray(FRAME_SIZE)
    for y in range(HEIGHT):
        for x in range(WIDTH):
            val = int(255 * (x / (WIDTH - 1)) * (y / (HEIGHT - 1)))
            set_pixel(buf, x, y, val)
    send_frame(buf)
    print("[Screen] Gradient test pattern rendered (2D intensity ramp).", flush=True)

def main():
    parser = argparse.ArgumentParser(description="AtriOS Gowin 25x16 Matrix Controller")
    parser.add_argument("--clear", action="store_true", help="Turn off all LEDs")
    parser.add_argument("--fill", type=int, nargs="?", const=200, help="Fill all LEDs with brightness (0..255)")
    parser.add_argument("--clock", action="store_true", help="Display current system time")
    parser.add_argument("--eyes", type=str, nargs="?", const="open",
                        choices=["open", "blink", "left", "right", "wink", "happy", "animate"],
                        help="Display animated eyes")
    parser.add_argument("--pixel", type=int, nargs="+", help="X Y [brightness]: light single pixel")
    parser.add_argument("--row", type=int, nargs="+", help="Y [brightness]: light entire row")
    parser.add_argument("--col", type=int, nargs="+", help="X [brightness]: light entire column")
    parser.add_argument("--gradient", action="store_true", help="Test individual LED brightness levels")
    parser.add_argument("--brightness", type=int, default=220, help="Global brightness level (0..255)")

    args = parser.parse_args()

    if args.clear:
        clear_screen()
    elif args.fill is not None:
        fill_screen(args.fill)
    elif args.clock:
        draw_clock(args.brightness)
    elif args.gradient:
        test_gradient()
    elif args.eyes:
        if args.eyes == "animate":
            print("[Screen] Running Alice eye animation sequence...", flush=True)
            for state in ["open", "wink", "open", "blink", "open", "left", "right", "happy", "open"]:
                draw_eyes(state, args.brightness)
                time.sleep(0.4 if state != "open" else 1.2)
        else:
            draw_eyes(args.eyes, args.brightness)
    elif args.pixel:
        x, y = args.pixel[0], args.pixel[1]
        b = args.pixel[2] if len(args.pixel) > 2 else args.brightness
        buf = bytearray(FRAME_SIZE)
        set_pixel(buf, x, y, b)
        send_frame(buf)
        print(f"[Screen] Lit pixel ({x}, {y}) at brightness {b}/255", flush=True)
    elif args.row:
        y = args.row[0]
        b = args.row[1] if len(args.row) > 1 else args.brightness
        buf = bytearray(FRAME_SIZE)
        for x in range(WIDTH):
            set_pixel(buf, x, y, b)
        send_frame(buf)
        print(f"[Screen] Lit row {y} at brightness {b}/255", flush=True)
    elif args.col:
        x = args.col[0]
        b = args.col[1] if len(args.col) > 1 else args.brightness
        buf = bytearray(FRAME_SIZE)
        for y in range(HEIGHT):
            set_pixel(buf, x, y, b)
        send_frame(buf)
        print(f"[Screen] Lit column {x} at brightness {b}/255", flush=True)
    else:
        draw_clock(args.brightness)

if __name__ == "__main__":
    main()
