#!/usr/bin/env python3
import sys
import os
import struct
import select

def find_rotary_device():
    # Check /proc/bus/input/devices
    try:
        with open("/proc/bus/input/devices", "r") as f:
            content = f.read()
            blocks = content.split("\n\n")
            for block in blocks:
                if 'Name="rotary-volume"' in block:
                    for line in block.splitlines():
                        if line.startswith("H: Handlers="):
                            for h in line.split():
                                if h.startswith("event"):
                                    dev = f"/dev/input/{h}"
                                    if os.path.exists(dev):
                                        return dev
    except Exception:
        pass
    # Fallback search
    for i in range(10):
        dev = f"/dev/input/event{i}"
        if os.path.exists(dev):
            return dev
    return None

def main():
    dev_path = find_rotary_device()
    if not dev_path or not os.path.exists(dev_path):
        print(f"[Rotary Test] ERROR: rotary-volume device not found in /dev/input!")
        sys.exit(1)

    print(f"==================================================")
    print(f"[Rotary Test] Monitoring Rotary Knob: {dev_path}")
    print(f"Rotate knob clockwise or counter-clockwise...")
    print(f"Press Ctrl+C to exit.")
    print(f"==================================================")

    # struct input_event: timeval (16 bytes on 64-bit), uint16 type, uint16 code, int32 value
    # Total 24 bytes
    EVENT_FORMAT = "QQHHi"
    EVENT_SIZE = struct.calcsize(EVENT_FORMAT)

    KEY_PAGEUP = 104    # Clockwise
    KEY_PAGEDOWN = 109  # Counter-clockwise

    vol = 50
    try:
        with open(dev_path, "rb") as f:
            while True:
                data = f.read(EVENT_SIZE)
                if len(data) < EVENT_SIZE:
                    break
                sec, usec, ev_type, ev_code, ev_value = struct.unpack(EVENT_FORMAT, data)
                # EV_KEY = 1, value = 1 (press)
                if ev_type == 1 and ev_value == 1:
                    if ev_code == KEY_PAGEUP:
                        vol = min(100, vol + 5)
                        bar = "#" * (vol // 5) + "-" * (20 - (vol // 5))
                        print(f"--> [CLOCKWISE (+)] Volume: {vol:3d}% [{bar}] (KEY_PAGEUP)")
                    elif ev_code == KEY_PAGEDOWN:
                        vol = max(0, vol - 5)
                        bar = "#" * (vol // 5) + "-" * (20 - (vol // 5))
                        print(f"<-- [COUNTER-CLOCKWISE (-)] Volume: {vol:3d}% [{bar}] (KEY_PAGEDOWN)")
                    else:
                        print(f"Event: Code={ev_code}, Val={ev_value}")
    except KeyboardInterrupt:
        print("\n[Rotary Test] Exiting.")

if __name__ == "__main__":
    main()
