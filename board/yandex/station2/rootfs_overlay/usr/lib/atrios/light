# --- Ambient Light Sensor ---
def read_sensor_lux():
    if os.path.exists(SENSOR_PATH):
        try:
            with open(SENSOR_PATH, "r") as f:
                val = float(f.read().strip())
                return val * 0.2  # 0.2 lux per count for LTR-308ALS
        except Exception:
            pass
    return None

# --- Screen Methods (1200 bytes, 3 bytes per pixel) ---
def screen_set_pixel(buf, x, y, brightness):
    if 0 <= x < SCR_W and 0 <= y < SCR_H:
        val = max(0, min(255, int(brightness)))
        offset = (y * SCR_W + x) * SCR_BPP
        buf[offset + 0] = val
        buf[offset + 1] = val
        buf[offset + 2] = val

def screen_send_frame(buf):
    try:
        with open(FB_SCREEN, "wb") as f:
            f.write(buf[:SCR_SIZE])
            f.flush()
        return True
    except Exception as e:
        print(f"[Screen Error] Failed writing {FB_SCREEN}: {e}", flush=True)
        return False

def screen_clear():
    screen_send_frame(bytearray(SCR_SIZE))
    print("[Screen] Cleared (All LEDs OFF).", flush=True)

def screen_fill(brightness=200):
    val = max(0, min(255, int(brightness)))
    buf = bytearray(SCR_SIZE)
    for y in range(SCR_H):
        for x in range(SCR_W):
            screen_set_pixel(buf, x, y, val)
    screen_send_frame(buf)
    print(f"[Screen] Filled with brightness {val}/255.", flush=True)

def screen_clock(brightness=220):
    now = time.strftime("%H:%M")
    buf = bytearray(SCR_SIZE)
    x_positions = [1, 7, 12, 14, 20]
    for char, x_start in zip(now, x_positions):
        glyph = FONT_5X7.get(char, [0]*7)
        for row_idx, row_bits in enumerate(glyph):
            y = 4 + row_idx
            for col_idx in range(5):
                if (row_bits >> (4 - col_idx)) & 1:
                    screen_set_pixel(buf, x_start + col_idx, y, brightness)
    screen_send_frame(buf)
    print(f"[Screen] Clock: {now} (brightness={brightness}/255)", flush=True)

def screen_eyes(state="open", brightness=220):
    buf = bytearray(SCR_SIZE)
    if state == "open":
        for y in range(4, 11):
            for x in range(4, 9):
                screen_set_pixel(buf, x, y, brightness)
            for x in range(16, 21):
                screen_set_pixel(buf, x, y, brightness)
        screen_set_pixel(buf, 5, 5, 255)
        screen_set_pixel(buf, 17, 5, 255)
    elif state == "blink":
        for x in range(3, 10):
            screen_set_pixel(buf, x, 7, brightness)
        for x in range(15, 22):
            screen_set_pixel(buf, x, 7, brightness)
    elif state == "left":
        for y in range(4, 11):
            for x in range(2, 7):
                screen_set_pixel(buf, x, y, brightness)
            for x in range(14, 19):
                screen_set_pixel(buf, x, y, brightness)
    elif state == "right":
        for y in range(4, 11):
            for x in range(6, 11):
                screen_set_pixel(buf, x, y, brightness)
            for x in range(18, 23):
                screen_set_pixel(buf, x, y, brightness)
    elif state == "wink":
        for y in range(4, 11):
            for x in range(4, 9):
                screen_set_pixel(buf, x, y, brightness)
        for x in range(15, 22):
            screen_set_pixel(buf, x, 7, brightness)
    elif state == "happy":
        for x in range(4, 9):
            screen_set_pixel(buf, x, 4, brightness)
        screen_set_pixel(buf, 3, 5, brightness)
        screen_set_pixel(buf, 9, 5, brightness)
        for x in range(16, 21):
            screen_set_pixel(buf, x, 4, brightness)
        screen_set_pixel(buf, 15, 5, brightness)
        screen_set_pixel(buf, 21, 5, brightness)
    screen_send_frame(buf)
    print(f"[Screen] Eyes: {state} (brightness={brightness}/255)", flush=True)

def screen_ticker(text, brightness=220, speed=0.07):
    text = " " + text.upper() + " "
    # Build complete text pixel buffer
    total_cols = len(text) * 6
    text_grid = [[0]*total_cols for _ in range(7)]
    for char_idx, char in enumerate(text):
        glyph = FONT_5X7.get(char, [0]*7)
        for r, row_bits in enumerate(glyph):
            for c in range(5):
                if (row_bits >> (4 - c)) & 1:
                    text_grid[r][char_idx * 6 + c] = 1

    print(f"[Screen] Scrolling: \"{text.strip()}\"...", flush=True)
    try:
        for offset in range(total_cols - SCR_W + 1):
            buf = bytearray(SCR_SIZE)
            for r in range(7):
                y = 4 + r
                for x in range(SCR_W):
                    if text_grid[r][offset + x]:
                        screen_set_pixel(buf, x, y, brightness)
            screen_send_frame(buf)
            time.sleep(speed)
    except KeyboardInterrupt:
        pass
    screen_clear()

# --- Ring Methods (72 bytes /dev/fb5) ---
def ring_send_frame(frame):
    try:
        with open(FB_RING, "wb") as f:
            f.write(frame[:RING_SIZE])
            f.flush()
        return True
    except Exception as e:
        print(f"[Ring Error] Failed writing {FB_RING}: {e}", flush=True)
        return False

def ring_clear():
    ring_send_frame(b"\x00" * RING_SIZE)
    print("[Ring] Turned OFF.", flush=True)

def ring_fill(r, g, b):
    r, g, b = max(0, min(255, int(r))), max(0, min(255, int(g))), max(0, min(255, int(b)))
    frame = bytes([r, g, b]) * RING_LEDS
    ring_send_frame(frame)
    print(f"[Ring] Filled RGB({r}, {g}, {b}).", flush=True)

def ring_rainbow(speed=0.05, duration=5.0):
    print("[Ring] Running rainbow animation...", flush=True)
    start = time.time()
    step = 0
    try:
        while (time.time() - start) < duration:
            frame = bytearray(RING_SIZE)
            for i in range(RING_LEDS):
                hue = (step + i * (360 // RING_LEDS)) % 360
                # HSL to RGB
                c = 255
                x = int(c * (1 - abs((hue / 60) % 2 - 1)))
                if hue < 60:    r, g, b = c, x, 0
                elif hue < 120: r, g, b = x, c, 0
                elif hue < 180: r, g, b = 0, c, x
                elif hue < 240: r, g, b = 0, x, c
                elif hue < 300: r, g, b = x, 0, c
                else:           r, g, b = c, 0, x
                frame[i*3 + 0] = r
                frame[i*3 + 1] = g
                frame[i*3 + 2] = b
            ring_send_frame(frame)
            step = (step + 10) % 360
            time.sleep(speed)
    except KeyboardInterrupt:
        pass
    ring_clear()

def ring_volume(pct):
    pct = max(0, min(100, int(pct)))
    active = int(round(RING_LEDS * (pct / 100.0)))
    frame = bytearray(RING_SIZE)
    for i in range(RING_LEDS):
        if i < active:
            ratio = i / max(1, RING_LEDS - 1)
            frame[i * 3 + 0] = int(180 * ratio)
            frame[i * 3 + 1] = int(220 * (1.0 - ratio))
            frame[i * 3 + 2] = 255
    ring_send_frame(frame)
    print(f"[Ring] Volume arc: {pct}% ({active}/{RING_LEDS} LEDs lit).", flush=True)

def main():
    parser = argparse.ArgumentParser(description="AtriOS Unified Light & Display Controller")
    subparsers = parser.add_subparsers(dest="component", help="Subsystem: screen, ring, sensor, all")

    # Screen parser
    p_scr = subparsers.add_parser("screen", help="Front 25x16 monochrome matrix")
    p_scr.add_argument("action", nargs="?", default="clock",
                       choices=["clock", "eyes", "ticker", "pixel", "row", "col", "gradient", "fill", "clear", "off", "smile", "happy", "test"],
                       help="Action to perform")
    p_scr.add_argument("value", nargs="*", help="Arguments for action (e.g. text for ticker, X Y for pixel)")
    p_scr.add_argument("--brightness", type=int, default=220, help="Brightness level (0..255)")

    # Ring parser
    p_ring = subparsers.add_parser("ring", help="Top 24-channel RGB LED ring")
    p_ring.add_argument("action", nargs="?", default="rainbow",
                        choices=["rainbow", "volume", "red", "blue", "green", "fill", "clear", "off"],
                        help="Ring effect")
    p_ring.add_argument("value", nargs="*", help="Parameters (e.g. volume percent, RGB values)")

    # Sensor parser
    subparsers.add_parser("sensor", help="Read ambient light sensor (Lux)")

    args = parser.parse_args()

    if args.component == "sensor":
        lux = read_sensor_lux()
        if lux is not None:
            print(f"[Sensor] Ambient Light (LTR-308ALS): \033[1;36m{lux:.1f} Lux\033[0m", flush=True)
        else:
            print("[Sensor] LTR-308ALS not found on sysfs.", flush=True)

    elif args.component == "ring":
        act = args.action
        if act in ("off", "clear"):
            ring_clear()
        elif act == "red":
            ring_fill(255, 0, 0)
        elif act == "blue":
            ring_fill(0, 0, 255)
        elif act == "green":
            ring_fill(0, 255, 0)
        elif act == "rainbow":
            ring_rainbow()
        elif act == "volume":
            pct = int(args.value[0]) if args.value else 50
            ring_volume(pct)
        elif act == "fill":
            r = int(args.value[0]) if len(args.value) > 0 else 255
            g = int(args.value[1]) if len(args.value) > 1 else 255
            b = int(args.value[2]) if len(args.value) > 2 else 255
            ring_fill(r, g, b)

    elif args.component == "screen":
        act = args.action
        b = args.brightness
        if act in ("clear", "off"):
            screen_clear()
        elif act == "fill":
            val = int(args.value[0]) if args.value else b
            screen_fill(val)
        elif act == "clock":
            screen_clock(b)
        elif act in ("eyes", "smile", "happy"):
            state = "happy" if act in ("smile", "happy") else (args.value[0] if args.value else "open")
            if state == "animate":
                for s in ["open", "wink", "open", "blink", "open", "left", "right", "happy", "open"]:
                    screen_eyes(s, b)
                    time.sleep(0.4 if s != "open" else 1.2)
            else:
                screen_eyes(state, b)
        elif act == "test":
            screen_fill(100)
            time.sleep(0.8)
            screen_eyes("happy", b)
            time.sleep(1.0)
            screen_ticker("ATRIOS", b)
            screen_clock(b)
        elif act == "ticker":
            text = " ".join(args.value) if args.value else "ATRIOS"
            screen_ticker(text, b)
        elif act == "pixel":
            if len(args.value) >= 2:
                x, y = int(args.value[0]), int(args.value[1])
                val = int(args.value[2]) if len(args.value) > 2 else b
                buf = bytearray(SCR_SIZE)
                screen_set_pixel(buf, x, y, val)
                screen_send_frame(buf)
                print(f"[Screen] Set pixel ({x}, {y}) = {val}/255", flush=True)
            else:
                print("Usage: atrios screen pixel <x> <y> [brightness]", flush=True)
        elif act == "gradient":
            buf = bytearray(SCR_SIZE)
            for y in range(SCR_H):
                for x in range(SCR_W):
                    v = int(255 * (x / (SCR_W - 1)) * (y / (SCR_H - 1)))
                    screen_set_pixel(buf, x, y, v)
            screen_send_frame(buf)
            print("[Screen] Gradient test pattern rendered.", flush=True)

    else:
        # Default overview
        print("==========================================================", flush=True)
        print("          AtriOS Unified Light & Display Manager          ", flush=True)
        print("==========================================================", flush=True)
        lux = read_sensor_lux()
        if lux is not None:
            print(f"  * Ambient Light Sensor: \033[1;36m{lux:.1f} Lux\033[0m", flush=True)
        print(f"  * Front Matrix: Gowin 25x16 ({FB_SCREEN}, 1200B RGB888)", flush=True)
        print(f"  * Top RGB Ring: 24 Channels ({FB_RING}, 72B RGB)", flush=True)
        print("\nCommands:")
        print("  atrios screen clock           - Display current time")
        print("  atrios screen eyes [state]    - Alice eyes (open/blink/wink/left/right/happy/animate)")
        print("  atrios screen ticker \"TEXT\"  - Scrolling marquee")
        print("  atrios screen pixel X Y [B]   - Individual LED control (0..255)")
        print("  atrios screen off             - Turn off screen")
        print("  atrios ring rainbow           - Rainbow animation")
        print("  atrios ring volume 70         - Volume arc at 70%")
        print("  atrios ring red               - Mic Mute solid red")
        print("  atrios ring off               - Turn off ring")
        print("  atrios sensor                 - Read live lux level")
        print("==========================================================", flush=True)

if __name__ == "__main__":
    main()
