#!/usr/bin/env python3
"""
AtriOS Unified Light & Display Control Utility (atrios-light)
Combines:
  1. Front Gowin 25x16 monochrome matrix (per-pixel brightness 0..255, 1200B RGB888 /dev/fb4)
  2. Top 24-channel RGB LED ring (IS31FL3236A, /dev/fb5)
  3. Ambient Light Sensor (Lite-On LTR-308ALS live lux)
"""

import sys
import os
import time
import argparse
import math

FB_SCREEN = "/dev/fb4"
FB_RING = "/dev/fb5"
SENSOR_PATH = "/sys/bus/iio/devices/iio:device0/in_intensity_input"

# Screen Geometry
SCR_W = 25
SCR_H = 16
SCR_BPP = 3
SCR_SIZE = SCR_W * SCR_H * SCR_BPP

# Ring Geometry
RING_LEDS = 24
RING_SIZE = RING_LEDS * 3

FONT_5X7 = {
