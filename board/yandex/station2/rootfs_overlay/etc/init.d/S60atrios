#!/bin/sh
# /etc/init.d/S60atrios - Launch AtriOS user interaction daemons (rotary & screen)

case "$1" in
  start)
    echo "[AtriOS] Starting user interface daemons..."
    if [ -x /usr/bin/atrios-rotaryd ]; then
      /usr/bin/atrios-rotaryd >/var/log/atrios-rotaryd.log 2>&1 &
    fi
    if [ -x /usr/bin/atrios-screend ]; then
      /usr/bin/atrios-screend >/var/log/atrios-screend.log 2>&1 &
    fi
    ;;
  stop)
    killall atrios-rotaryd atrios-screend 2>/dev/null || true
    ;;
  *)
    echo "Usage: $0 {start|stop}"
    exit 1
esac
exit 0
