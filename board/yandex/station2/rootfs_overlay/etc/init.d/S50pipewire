#!/bin/sh
# /etc/init.d/S50pipewire - Launch PipeWire audio engine and WirePlumber session manager

case "$1" in
  start)
    echo "[AtriOS] Starting PipeWire audio engine..."
    mkdir -p /var/run/pipewire
    export XDG_RUNTIME_DIR=/var/run/pipewire
    chmod 0700 /var/run/pipewire

    if command -v pipewire >/dev/null 2>&1; then
      pipewire &
      sleep 1
      if command -v wireplumber >/dev/null 2>&1; then
        wireplumber &
      elif command -v pipewire-media-session >/dev/null 2>&1; then
        pipewire-media-session &
      fi
    fi
    ;;
  stop)
    killall wireplumber pipewire-media-session pipewire 2>/dev/null || true
    ;;
  *)
    echo "Usage: $0 {start|stop}"
    exit 1
esac
exit 0
